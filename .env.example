# Copy this to .env and fill in real values. DO NOT commit .env.

# --- LLM (for synthesis) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# --- Web search provider ---
WEB_SEARCH_PROVIDER=duckduckgo

# --- SE-layer settings ---
LOG_LEVEL=INFO
CACHE_DIR=./.cache
CACHE_TTL_SECONDS=86400
PER_SOURCE_TIMEOUT_SECONDS=10
MAX_SOURCES_PER_QUERY=3